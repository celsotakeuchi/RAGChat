# Copy to .env and fill in. Never commit .env.

# --- LLM (any LiteLLM model string; switch provider by changing these) ---
# LLM_PROVIDER: "litellm" (uses CHAT_MODEL) or "ollama_cloud" (uses OLLAMA_MODEL on https://ollama.com)
LLM_PROVIDER=litellm
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
CHAT_MODEL=azure/gpt-4o            # e.g. gpt-4o-mini, azure/<deployment>, ollama/llama3.1
# Embeddings: "local" uses fastembed (no key needed); "litellm" uses EMBEDDING_MODEL via LiteLLM
# --- Retrieval (see retrieval/backends.py and embeddings.py registries) ---
RETRIEVER_BACKEND=sqlite
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=text-embedding-3-small

# Provider credentials (only what your provider needs)
OPENAI_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# --- Storage (KB is versioned and separate from logs/usage) ---
KB_DB_PATH=data/kb.sqlite3
OPS_DB_PATH=data/ops.sqlite3

# --- Token budgets (0 = unlimited) ---
MAX_OUTPUT_TOKENS=700
MAX_REQUEST_TOKENS=6000
DAILY_TOKENS_PER_USER=100000
MONTHLY_TOKEN_BUDGET=0

# --- Authentication (required when AUTH_ENABLED=true, the default) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_ENABLED=true
JWT_SECRET=
SESSION_HOURS=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Anonymous public page (off by default) ---
PUBLIC_ACCESS_ENABLED=false
PUBLIC_SESSION_HOURS=2
PUBLIC_RATE_PER_MINUTE=10
PUBLIC_IP_SESSIONS_PER_HOUR=20
PUBLIC_DAILY_TOKEN_BUDGET=200000
PUBLIC_RETENTION_DAYS=30
PUBLIC_CORS_ORIGINS=[]
IP_HASH_SALT=

# --- API ---
KB_CONFIG=kb/air_passenger_rights.yaml
CORS_ORIGINS=["http://localhost:8001"]

# --- UI ---
API_URL=http://localhost:8000
